<!DOCTYPE html>
<html>

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title></title>
</head>
<style>
  
#barra{
	position: absolute;
	background: transparent;
	width: 50px;
	height: auto;
	transition: .5s ease;
}

.cuadro {
	width: 50px;
	height: 100px;
	position: relative;
  position: relative;
	justify-content: center;
	border: 1px solid lightgray;
	align-items: center;
	margin: auto;
	top: 100px;
	transform: rotate(180deg)
}

.boton{
	width: 100px;
	height: 100px;
	position: relative;
	top: 200px;
	align-items: center;
	justify-content: center;
	margin: auto
}

.boton button{
	width: 100px;
	height: 30px;
	position: relative;
	top: 10px;
}

.boton input{
	width: 93px;
	height: 25px;
	position: relative;
  font-size: 25px;
  text-align: center;
}

h3{
	position: absolute;
	text-align: center;
	transform: rotate(180deg);
	left: 10px;
	top: 20px;
	
}

#cabeza{
	width: 22px;
	height: 5px;
}

#mensaje{
	position: relative;
	text-align: center;
	top: 150px;
}

#input_user{
	position: absolute;
	border: none;
	width: 100px;
	height: 30px;
	top: 500px;
	
}

#input_user input{
	width: 100px;
	height: 30px;
	position: absolute;
	font-size: 25px;
  text-align: center;
}

#hora{
	position: relative;
	text-align: center;
}


#tiempo_acabar{
	position: relative;
	text-align: center;
	top: 150px;
}

#uso{
	text-align: center;
	position: relative;
	top: 150px;
}

  
</style>
<body>
	<h1 id="hora"></h1>
	<div class="cuadro" id="cabeza">
		
	</div>
	<div class="cuadro">
	<div id="barra">
			<h3 id="porcentaje"></h3>
	</div>
	</div>
	<h2 id="mensaje"></h2>
		<h2 id="uso"></h2>
	<br>
	
</body>
<script> 
const barra = document.getElementById('barra');
const batería = document.getElementById('porcentaje');
const press = document.getElementById('press');
const mensaje = document.getElementById('mensaje');
const horaActual = document.getElementById('hora');


setInterval(() => {

    navigator.getBattery().then(bateriaInfo => {
        let nivelBateria = Math.min(100, Math.round(bateriaInfo.level * 100)); // Redondea y limita a 100

       let numero = nivelBateria;
       let porcentaje = parseInt(numero)
       document.getElementById('uso').textContent = `Uso: ${100 - porcentaje}% , Restante: ${porcentaje - 20 }%` 
       

        if (numero > 20 && numero < 80) {
            barra.style.height = numero + 'px';
            barra.style.background = "green";
            mensaje.textContent = "Me siento bien, tengo energía.";
        } else if (numero >= 80 && numero <= 100) {
            barra.style.height = numero + 'px';
            barra.style.background = "green";
            mensaje.textContent = "Gracias por cargarme y cuidarme, tengo tanta energía :)";
        }  else if (numero <= 20 && numero > 15) {
            barra.style.height = numero + 'px';
            barra.style.background = "orange";
            mensaje.textContent = "Ya estoy un poco agotado, quiero que me cargues un poco.";
        } else if (numero > 0 && numero <= 15) {
            barra.style.height = numero + 'px';
            barra.style.background = "red";
            mensaje.textContent = "Ya tengo poca batería, cárgame por favor.";
        } else if (numero === 0) {
            barra.style.height = numero + 'px';
            barra.style.background = "red";
            mensaje.textContent = "El teléfono ya no responde.";
        } else if (numero > 100) {
            mensaje.textContent = "No identifico este porcentaje de batería. Seguro hiciste algo mal. Recuerda que el máximo es 100.";
        } else if (isNaN(numero)) {
            mensaje.textContent = "No tengo ni idea de cuánto porcentaje tienes, ¿me puedes decir?";
        }
        
    

       batería.textContent = numero + '%'; // Asegurar que el porcentaje se muestra correctamente
  
    });
    

 
},100)

   
      
setInterval(() => {
    let fechaActual = new Date(); 
    let hora = fechaActual.getHours()
    let minutos = fechaActual.getMinutes().toString().padStart(2, '0');
    let segundos = fechaActual.getSeconds().toString().padStart(2, '0');
    
    if (hora == 0) {
    	hora = 12
    }
    
    
    horaActual.textContent = `${hora % 12}:${minutos}:${segundos}`;
    
 
 
   
   if (hora >= 6 && hora <= 17) {
	document.body.style.background ='whitesmoke';
	document.body.style.color = "black"
	
	document.querySelector('div').style.borderColor = 'black';
	
} else {
	document.body.style.background = 'black'
	
	document.body.style.color = "whitesmoke"


}


   
    
}, 1000);
  
</script>
  </html>
